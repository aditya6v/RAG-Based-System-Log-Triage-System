# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (URL-encode special characters in the password)
MONGO_URI=<mongodb+srv://user:password@cluster.example.mongodb.net/>
MONGO_DB_NAME=incident_copilot_bgl

# Qdrant Cloud cluster URL and API key
QDRANT_URL=<https://your-cluster.cloud.qdrant.io>
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_COLLECTION=bgl_incidents

# Chat providers, tried in this order. Hosted ones without a key are skipped,
# so with no keys only the local Ollama model is used.
LLM_PROVIDER_CHAIN=groq,openrouter,ollama
LLM_TIMEOUT_S=30
# Mask IPs, node/host names, user names and tokens before text goes to a
# hosted provider. 0 turns it off. Ollama is local and never redacted.
REDACT_HOSTED=1

# Groq (console.groq.com). Free-tier limits and model names change; check the console.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (openrouter.ai). ":free" models have their own daily limits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Local Ollama: the offline last resort, and the default embedding model.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Keep models loaded this long after the last call (Ollama default is 5m)
OLLAMA_KEEP_ALIVE=30m

# Embeddings: ollama (default) or fastembed (same nomic model in-process, for
# running without Ollama; needs `pip install fastembed`). Never mix: the index
# and the queries must use the same model.
EMBED_PROVIDER=ollama
FASTEMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# Optional: Gemini as a chat provider (add "gemini" to LLM_PROVIDER_CHAIN)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
